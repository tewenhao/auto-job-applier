# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# --- Anthropic (LLM) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides (defaults shown):
# MODEL_INTERVIEW=claude-opus-5
# MODEL_PARSE=claude-haiku-4-5
# MODEL_CONSOLIDATE=claude-opus-5

# --- Supabase (source of truth) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# --- GitHub (profile ingestion) ---
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=your-github-username

# --- Profile ---
# The master document: the human source of truth. New entries captured in the
# dashboard are appended here (a .bak is kept), then re-ingested.
# MASTER_DOC_PATH=candidate-inputs/master-doc.md

# --- Listings (Module 2) ---
# LISTING_SCORE_THRESHOLD=60   # listings scoring >= this (0-100) are surfaced
